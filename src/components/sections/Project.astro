---
const { imageUrl, title, type, link } = Astro.props;
---

<a href={link} target="_blank" rel="noopener noreferrer">
    <div class="relative overflow-hidden rounded-lg cursor-pointer h-64 group">
        <div
            class="absolute inset-0 bg-cover transition-transform duration-700 group-hover:scale-110"
            style={`background-image: url('${imageUrl}');`}>
        </div>

        <div
            class="flex flex-col justify-start items-end hover:translate-x-[-70%] w-full h-full px-8 py-4 transition-all duration-700
                opacity-70 backdrop-blur-sm bg-gray-900/85 group-hover:opacity-90">
            <h2 class="mt-4 text-xl md:text-lg font-semibold text-white text-right">{title}</h2>
            <p class="text-base tracking-wider text-white lowercase">{type}</p>
        </div>
    </div>
</a>
