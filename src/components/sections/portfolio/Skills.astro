---
import { skills } from '../../../config/cv.json';
import SkillItem from './SkillItem.astro';



const skillCategories = {
  [skills.programmingLanguages.name]: skills.programmingLanguages.items,
  [skills.frameworks.name]: skills.frameworks.items,
  [skills.cloud.name]: skills.cloud.items,
  [skills.cicd.name]: skills.cicd.items,
  [skills.tools.name]: skills.tools.items,
};

// const display = false;
---

<section class="py-14 bg-background">
  <div class="container mx-auto">
    <h2 class="text-3xl lg:text-4xl font-semibold text-justify mb-12">
        Technical Skills
    </h2>

    <ul class="space-y-4">
      {Object.entries(skillCategories).map(([categoryName, categorySkills]) => (
      <SkillItem
        key={categoryName}
        categoryName={categoryName}
        categorySkills={categorySkills}
      />
      ))}
    </ul>
  </div>
</section>
