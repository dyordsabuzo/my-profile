---
import { skills } from '../../../config/cv.json';
import SkillItem from './SkillItem.astro';

let skillCategories = {};

Object.values(skills).forEach(value => {
  const {name,items} = value;
    skillCategories = {
      ...skillCategories,
      [name]: items
    }
});
---

<section class="py-14 bg-background">
  <div class="container mx-auto">
    <h2 class="text-3xl lg:text-4xl font-semibold text-justify mb-12">
        Technical Skills
    </h2>

    <ul class="space-y-4">
      {Object.entries(skillCategories).map(([categoryName, categorySkills]) => (
      <SkillItem
        key={categoryName}
        categoryName={categoryName}
        categorySkills={categorySkills}
      />
      ))}
    </ul>
  </div>
</section>
