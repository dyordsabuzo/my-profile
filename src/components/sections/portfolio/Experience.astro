---
import CardListSection from "./CardListSection.astro";
import { experiences } from '../../../config/cv.json';
import { companies } from '../../../config/companies.json';

const updatedExperiences = experiences.map((item) => {
  const {logo: photo, overview} = companies.find((company) => company.name === item.sub_title);
  return {
    ...item,
    photo,
    overview,
  };
});

---

<CardListSection title="Experience" items={updatedExperiences.filter((item) => !item.exclude)} />
