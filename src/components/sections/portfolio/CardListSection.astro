---
import CardListItem from './CardListItem.astro';

interface Item {
  title: string;
  sub_title: string;
  years: string;
  location?: string;
  overview?: string;
  details?: string[];
}

const { title, items } = Astro.props;
---

<section class="py-14 bg-background">
  <div class="container mx-auto">
    <h2 class="text-3xl lg:text-4xl font-semibold text-justify mb-12">
        {title}
    </h2>

    <ul class="space-y-8">
      {items.map((item: Item) => (
        <CardListItem
          title={item.title}
          sub_title={item.sub_title}
          years={item.years}
          location={item.location}
          overview={item?.overview}
          details={item?.details}
        />
      ))}
    </ul>
  </div>
</section>
