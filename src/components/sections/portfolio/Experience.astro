---
import CardListSection from "./CardListSection.astro";
import { experiences, companies } from '../../../config/cv.json';

const updatedExperiences = experiences.map((item) => {
  const photo = companies.find((company) => company.name === item.sub_title)?.logo;
  return {
    ...item,
    photo
  };
});

---

<CardListSection title="Experience" items={updatedExperiences} />
