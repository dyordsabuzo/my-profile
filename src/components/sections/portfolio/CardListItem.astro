---
import { Icon } from "astro-icon/components";
const { title, sub_title, years, location, overview, details, photo } = Astro.props;
---

<li class="p-5 bg-background-offset shadow-lg rounded-xl border border-default">
  <div class="flex flex-col sm:flex-row justify-between items-start">
    <div class="mb-4 sm:mb-0">
        <div class="flex align-items-center justify-center gap-3">
            {photo && (
                <div class="w-12 h-12">
                    <img src={photo} alt={title} class="rounded-full border border-1 border-white" />
                </div>
            )}
            <div>
                <h3 class="text-xl font-semibold">{title}</h3>
                <p class="text-base font-medium text-secondary">{sub_title}</p>
            </div>
        </div>
    </div>
    <div class="text-sm text-offset sm:text-right whitespace-nowrap flex gap-4">
        <p class="text-offset whitespace-nowrap flex items-center gap-1">
            <Icon name="Calendar" />
            <span>{years}</span>
        </p>
        {location && (<p class="text-offset whitespace-nowrap flex items-center gap-1">
                <Icon name="Location" />
                <span>{location}</span>
            </p>)
        }
    </div>
  </div>
  {overview && <p class="mt-4 text-offset leading-relaxed">{overview}</p>}
  <ul class="list-disc pl-4 space-y-1 text-gray-500 text-sm">
    {details?.map((item: string) => (
        <li class="mt-4 text-offset leading-relaxed">{item}</li>
    ))}
  </ul>
</li>
